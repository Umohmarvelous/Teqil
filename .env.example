# Supabase Variables
EXPO_PUBLIC_SUPABASE_URL=your_supabase_url
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# Paystack API Keys
EXPO_PUBLIC_PAYSTACK_PUBLIC_KEY=your_paystack_public_key
PAYSTACK_SECRET_KEY=your_paystack_secret_key

# Optional Message Broker Config
# RABBITMQ_DEFAULT_USER=user
# RABBITMQ_DEFAULT_PASS=password

# ── Development only ─────────────────────────────────────────────────────────
# Bypass the Pro/Elite paywall so premium features can be tested without a
# subscription. Accepts: free | pro | elite. Leave unset/blank to use the
# account's real tier.
#
# Ignored entirely in release builds (gated on __DEV__ — see src/config/devFlags.ts).
# EXPO_PUBLIC_* values are inlined at bundle time, so restart Metro with
# `npx expo start -c` after changing this.
#
# You can also flip it at runtime with no rebuild: Settings → Developer.
# EXPO_PUBLIC_DEV_PREMIUM_TIER=elite
