# Project-scoped npm settings.
#
# This machine's connection drops HTTP/2 mid-transfer, which has previously
# corrupted node_modules partway through an install (see HANDOFF.md §8) and
# shows up as misleading ETARGET / "no matching version" errors when a metadata
# fetch is truncated. These settings make npm retry harder and open fewer
# parallel sockets, which is what actually survives the drops.
#
# NOTE: this project's package manager is bun (bun.lock). Prefer `bun install`
# / `bun add -d <pkg>`. These settings are here for the times npm is used
# anyway — directly, or under the hood by `npx expo install`.

fetch-retries=5
fetch-retry-mintimeout=20000
fetch-retry-maxtimeout=180000
fetch-timeout=300000

# Fewer concurrent connections = far fewer truncated responses on a flaky link.
maxsockets=3

# Don't let a slow registry abort the whole install.
prefer-offline=true
